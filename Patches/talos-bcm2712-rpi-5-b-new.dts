		pwr_button_default = "/soc@107c000000/pinctrl@7d504100/pwr-button-default-state";
		sdio2_30_default = "/soc@107c000000/pinctrl@7d504100/sdio2-30-default-state";
		uarta_24_default = "/soc@107c000000/pinctrl@7d504100/uarta-24-default-state";
		wl_on_default = "/soc@107c000000/pinctrl@7d504100/wl-on-default-state";
		gio = "/soc@107c000000/gpio@7d508500";
		uarta = "/soc@107c000000/serial@7d50c000";
