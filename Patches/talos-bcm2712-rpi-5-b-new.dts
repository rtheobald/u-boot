		pinctrl_aon = "/soc@107c000000/pinctrl@7d510700";
		emmc_aon_cd_default = "/soc@107c000000/pinctrl@7d510700/emmc-aon-cd-default-state";
		gio_aon = "/soc@107c000000/gpio@7d517c00";
		sdio2 = "/soc@107c000000/mmc@1100000";
