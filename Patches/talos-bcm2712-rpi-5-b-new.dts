		ddc0 = "/soc@107c000000/i2c@7d508200";
		ddc1 = "/soc@107c000000/i2c@7d508280";
		bsc_irq = "/soc@107c000000/interrupt-controller@7d508380";
		main_irq = "/soc@107c000000/interrupt-controller@7d508400";
		hdmi0 = "/soc@107c000000/hdmi@7c701400";
		hdmi1 = "/soc@107c000000/hdmi@7c706400";
		firmware = "/soc@107c000000/firmware";
		firmware_clocks = "/soc@107c000000/firmware/clocks";
		reset = "/soc@107c000000/firmware/reset";
		power = "/soc@107c000000/power";
		axi = "/axi";
		vc4 = "/axi/gpu";
		pcie0 = "/axi/pcie@1000100000";
		pcie1 = "/axi/pcie@1000110000";
		pcie2 = "/axi/pcie@1000120000";
		pci_ep_bus = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1";
		rp1_clocks = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/clocks@40018000";
		rp1_gpio = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/pinctrl@400d0000";
		usb_vbus_default_state = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/pinctrl@400d0000/usb-vbus-default-state";
		rp1_eth = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/ethernet@40100000";
		phy1 = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/ethernet@40100000/mdio/ethernet-phy@1";
		rp1_usb0 = "/axi/pcie@1000120000/rp1_nexus/pci-ep-bus@1/usb@40200000";
