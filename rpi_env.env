kernel_addr_r=0x10000000
fdt_addr_r=0x18000000
ramdisk_addr_r=0x20000000
# Ensure U-Boot doesn't try to relocate the large initramfs into a low memory hole
initrd_high=0xffffffffffffffff
# The "Safe" Boot Command that avoids the 0x80000 crash
bootcmd=printenv; tftp ${fdt_addr_r} bcm2712-rpi-5-b.dtb; tftp ${kernel_addr_r} vmlinuz; tftp ${ramdisk_addr_r} initramfs.xz;
bootargs=talos.platform=metal console=tty0 console=ttyAMA0,115200 earlycon=pl011,mmio32,0x107d001000 sysctl.kernel.kexec_load_disabled=1 talos.dashboard.disabled=1 init_on_alloc=1 slab_nomerge pti=on consoleblank=0 nvme_core.io_timeout=4294967295 printk.devkmsg=on selinux=0 module.sig_enforce=0

